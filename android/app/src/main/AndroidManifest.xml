<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Uploading the fixes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location. COARSE is required alongside FINE: on Android 12+ the user
         can grant "Approximate location" only, and without this declared that
         choice fails outright instead of degrading gracefully. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 10 (API 29) and up: the "Allow all the time" grant. Without
         this declared, geolocator will never even offer the upgrade. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service. FOREGROUND_SERVICE_LOCATION is mandatory from
         Android 14 (API 34); starting a location-typed service without it
         throws SecurityException at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Android 13 (API 33)+: the service notification is invisible without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeps the CPU alive between fixes while the screen is off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Restart tracking after a reboot without the user opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app ask to be exempted from Doze / OEM battery managers. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Devices without GPS hardware are not useful here, but keep it optional
         so the APK still installs on tablets and emulators. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="DynaOps"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- The companion app calls back in on this scheme:
                 dyngis://signin  asks for a session, so a rep who started in
                                  the PWA does not have to type a password there
                 dyngis://signout stops tracking and clears the session, so
                                  signing out over there means signing out here
                 A private scheme, not an https app link: these are one app
                 talking to another on the same device, never a web address
                 anyone should be able to route. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="dyngis"/>
            </intent-filter>
        </activity>

        <!-- The tracking service. Do not rename: flutter_foreground_task starts
             this exact class.

             foregroundServiceType is `location` alone, on purpose. Android 15
             force-stops `dataSync` services after ~6 hours per day, while
             `location` services have no such cap, so adding dataSync here
             would quietly kill all-day tracking.

             stopWithTask=false is what keeps reporting alive after the user
             swipes the app out of the recents list. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Android 11 (API 30)+ package visibility. Without this the app
             cannot see which app handles an https link, so url_launcher
             resolves nothing and the companion PWA never opens. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
